[Unit]
Description=Video Editor Web UI
After=network.target video-editor-asr.service
Wants=video-editor-asr.service

[Service]
Type=simple
WorkingDirectory=%h/video-editor
EnvironmentFile=-%h/video-editor/.env
Environment=ANALYZE_BACKEND=deepseek
Environment=ASR_URL=http://127.0.0.1:8123
ExecStart=%h/video-editor/.venv/bin/python -m uvicorn web.backend.app:app --host 0.0.0.0 --port 8000 --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
